# Look shared by every episode (only Set lines: no timing here)
Set Shell "bash"
Set FontFamily "JetBrainsMono Nerd Font"
Set FontSize 20
Set LineHeight 1.0
Set Width 1920
# 1080 minus a 140 px band at the bottom where render.sh puts the captions
Set Height 940
Set Padding 20
Set Theme "TokyoNight"
Set WindowBar Colorful
Set BorderRadius 10
Set Margin 10
Set MarginFill "#16161e"
Set Framerate 24
Set CursorBlink false
